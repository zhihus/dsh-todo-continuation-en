{
  "name": "@doiiarx/dsh-todo-continuation",
  "version": "0.2.0",
  "private": true,
  "description": "Todo-backed turn-stop gate and prompt plugin for DeepSeek Harness: blocks stop on unfinished work and prompts on no-todo or stale-todo streaks, configurable in the settings page.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhihus/dsh-todo-continuation-en.git"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md", "README.ru.md", "README.zh.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/todo-continuation.test.js"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
